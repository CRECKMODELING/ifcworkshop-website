---
import Base from "../layouts/Base.astro";
---

<Base title="Resources" description="Software tools and databases used across the flame chemistry community">
  <div class="content-body">
    <div class="page-header">
      <h1>Resources</h1>
      <p class="subtitle">Software tools and databases from the flame chemistry community</p>
    </div>

    <p>
      A community-curated list of software tools, mechanisms, and databases relevant to the
      FCWS topic areas. Suggestions for additions are welcome — get in touch via the
      <a href="/contact">contact page</a>, or
      <a href="https://github.com/CRECKMODELING/ifcworkshop-website/edit/main/src/pages/resources.astro" target="_blank" rel="noopener">propose a change directly on GitHub</a>.
    </p>

    <p class="coming-soon">COMING SOON</p>
  </div>
</Base>

<style>
.coming-soon {
  font-family: var(--font-serif);
  font-size: 4rem;
  color: var(--ink-faint);
  text-align: center;
  margin: 5rem 0;
}
</style>

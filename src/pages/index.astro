<style>
.linkedin-link,
.subscribe-link,
.slack-link,
.github-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.5rem;
  text-decoration: none;
  font-size: 0.8rem;
  border: none;
}
.linkedin-link {
  color: var(--ink);
}
.linkedin-link svg {
  color: #0a66c2;
  flex-shrink: 0;
}
.subscribe-link {
  color: var(--ink);
}
.slack-link {
  color: var(--ink);
}
.slack-link svg {
  flex-shrink: 0;
}
.github-link {
  color: var(--ink);
}
.github-link svg {
  flex-shrink: 0;
}
.paper-card {
  border-left: 3px solid var(--blue);
  background: var(--bg-tinted);
  padding: 1rem 1.25rem;
  margin-bottom: 1.5rem;
  display: flex;
  gap: 1.25rem;
  align-items: flex-start;
}

.paper-cover {
  width: 64px;
  flex-shrink: 0;
  border: 1px solid var(--rule);
}

.paper-info { flex: 1; }

.paper-title {
  font-style: italic;
  font-size: 0.9rem;
  color: var(--ink);
  margin-bottom: 0.35rem;
  line-height: 1.45;
}

.paper-authors {
  font-size: 0.8rem;
  color: var(--ink-muted);
  margin-bottom: 0.25rem;
}

.paper-ref {
  font-size: 0.8rem;
  color: var(--ink-muted);
  margin-bottom: 0.4rem;
}

.paper-doi {
  font-size: 0.78rem;
  color: var(--blue);
  border-bottom-color: transparent;
}
.paper-doi:hover { border-bottom-color: var(--blue); }

.special-issue-row {
  display: flex;
  gap: 1.75rem;
  align-items: flex-start;
}
.special-issue-row > div {
  flex: 1;
  min-width: 0;
}
.special-issue-cover {
  width: 150px;
  flex-shrink: 0;
  border: 1px solid var(--rule);
}

@media (max-width: 560px) {
  .special-issue-row { flex-direction: column; }
  .special-issue-cover { width: 130px; }
}

</style>

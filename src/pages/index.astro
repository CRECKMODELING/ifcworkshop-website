---
import Base from "../layouts/Base.astro";
import Ordinal from "../components/Ordinal.astro";
---

<Base
  title="FCWS"
  description="8th International Workshop on Flame Chemistry — Kyoto, Japan, 25–26 July 2026"
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-eyebrow">
        <span class="edition-badge"><Ordinal n={8} /> Edition</span>
        <span class="edition-year">Kyoto, Japan &middot; 2026</span>
      </div>
      <h1>International Workshop<br/>on Flame Chemistry</h1>
      <p class="hero-subtitle">
        Advancing combustion chemistry through experiments, theory, and chemical kinetics modeling
      </p>
      <div class="hero-meta">
        <div class="hero-meta-item">
          <span class="hero-meta-label">Date</span>
          <span class="hero-meta-value">25–26 July 2026</span>
        </div>
        <div class="hero-meta-item">
          <span class="hero-meta-label">Venue</span>
          <span class="hero-meta-value">Doshisha University, Kyoto</span>
        </div>
        <div class="hero-meta-item">
          <span class="hero-meta-label">Part of</span>
          <span class="hero-meta-value"><Ordinal n={41} /> ISOC Pre-Workshops</span>
        </div>
      </div>
      <div class="hero-actions">
        <a href="/registration" class="btn btn-primary">Register</a>
        <a href="/program" class="btn btn-ghost">View Program</a>
      </div>
    </div>
  </section>

  <!-- Key facts strip -->
  <div class="facts-strip">
    <div class="facts-strip-inner">
      <div class="fact-item">
        <div class="fact-label">Early Bird Deadline</div>
        <div class="fact-value">21 June 2026</div>
      </div>
      <div class="fact-item">
        <div class="fact-label">Regular Deadline</div>
        <div class="fact-value">12 July 2026</div>
      </div>
      <div class="fact-item">
        <div class="fact-label">Registration</div>
        <div class="fact-value">Via Combustion Institute</div>
      </div>
      <div class="fact-item">
        <div class="fact-label">Format</div>
        <div class="fact-value">Two full days + joint RCM session</div>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <div class="content-body">
    <div class="content-cols">

      <!-- Left: main text -->
      <div>
        <div class="section-rule">
          <h2>About the Workshop</h2>
        </div>
        <p>
          The International Workshop on Flame Chemistry (FCWS) aims to advance understanding
          of combustion chemistry through close interaction between experiments, theory, and
          chemical kinetics modeling — particularly in the context of the global energy transition.
        </p>
        <p>
          FCWS provides a focused forum to identify key scientific challenges, foster
          interdisciplinary collaboration, and promote coordinated strategies toward predictive
          combustion chemistry models. The workshop addresses fundamental and applied aspects
          of flame chemistry underlying flame propagation, ignition, pollutant formation, and
          combustion system performance.
        </p>
        <p>
          Building on outcomes from previous editions, discussions at the <Ordinal n={8} /> FCWS will be
          guided by a recent perspective paper arising from the <Ordinal n={7} /> FCWS in Milan (2024),
          published in <em>Combustion and Flame</em>:
        </p>

        <div class="paper-card">
          <a href="https://doi.org/10.1016/j.combustflame.2026.114863" target="_blank" rel="noopener" style="border:none; flex-shrink:0;">
            <img src="/images/combustion-flame-logo.jpg" alt="Combustion and Flame journal cover" class="paper-cover" />
          </a>
          <div class="paper-info">
            <p class="paper-title">
              "Flame Chemistry Workshop: a perspective on challenges and strategic actions
              in combustion experiments and chemical kinetics modeling"
            </p>
            <p class="paper-authors">
              B. Rotavera, L. Cai, F. Zhang, A. Comandini, N. Hansen,
              S.J. Klippenstein, B. Yang, M. Pelucchi
            </p>
            <p class="paper-ref">
              <em>Combustion and Flame</em>, Vol. 286, April 2026, Article 114863
            </p>
            <a
              href="https://doi.org/10.1016/j.combustflame.2026.114863"
              target="_blank"
              rel="noopener"
              class="paper-doi"
            >
              doi:10.1016/j.combustflame.2026.114863 →
            </a>
          </div>
        </div>

        <div class="section-rule" style="margin-top: 2.75rem;">
          <h2>Focus Areas — <Ordinal n={8} /> FCWS</h2>
        </div>
        <ul>
          <li>Sustainable fuels combustion (LFS, IDT, pollutants): H₂, NH₃, SAFs</li>
          <li>Advanced diagnostics for combustion measurements</li>
          <li>Plasma combustion: experiments and modelling</li>
          <li>AI-TST-ME: automation, benchmarking and knowledge transfer</li>
          <li>Chemical Kinetic Mechanisms: Progress in Accuracy and Details</li>
        </ul>

        <div class="section-rule" style="margin-top: 2.75rem;">
          <h2>Book of Abstracts</h2>
        </div>
        <div class="boa-card">
          <div class="boa-info">
            <span class="boa-eyebrow">Now available</span>
            <span class="boa-title">Book of Abstracts — <Ordinal n={8} /> FCWS 2026</span>
            <span class="boa-desc">The final collection of contributed abstracts for the Kyoto workshop is ready to download.</span>
          </div>
          <div class="boa-actions">
            <a href="/files/Book_of_Abstracts_FCWS_2026.pdf" class="boa-cta" download>
              <span>Download PDF</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M5 12l7 7 7-7"/>
              </svg>
            </a>
          </div>
        </div>

        <div class="section-rule" style="margin-top: 2.75rem;">
          <h2>Logistics Information</h2>
        </div>
        <p>
          FCWS sessions take place in <strong>Room 205, Rinkokan</strong>, with posters
          in Rooms 314 &amp; 315. Lunch is provided as bento boxes on both days, and the
          poster session on Day 1 is followed by a standing buffet reception (no alcohol
          on campus). WiFi is available via eduroam for academic attendees.
        </p>
        <p>
          <a href="/files/logistics-information.pdf" download>
            Logistics Information — building maps, session rooms &amp; WiFi (PDF) →
          </a>
        </p>

        <div class="section-rule" style="margin-top: 2.75rem;">
          <h2>From the last edition</h2>
        </div>
        <a href="/archive/2024" class="last-edition-photo-link">
          <img
            src="/images/archive/2024/IFCWS-img.jpg"
            alt="7th FCWS — Milan 2024"
            class="last-edition-photo"
            loading="lazy"
          />
          <span class="last-edition-caption">7th FCWS · Milan, July 2024 — See the full archive →</span>
        </a>

        <div class="section-rule" style="margin-top: 2.75rem;">
          <h2>History</h2>
        </div>
        <p>
          The workshop was founded in 2012 by <strong>Yiguang Ju</strong> (Princeton University)
          and <strong>Hai Wang</strong> (Stanford University) with the mission to assemble
          leading experts in combustion chemistry, flame diagnostics, and kinetic modeling to
          identify critical knowledge gaps and chart pathways toward predictive high-pressure
          flame chemistry.
        </p>
        <p>
          Since its inaugural edition at Warsaw University of Technology, the workshop has
          grown into a biennial community event held as a satellite of the International
          Symposium on Combustion, spanning Warsaw (2012), San Francisco (2014), Seoul (2016),
          Dublin (2018), Adelaide (2020, held online), online (2022), and Milan (2024). Each edition has
          produced structured research recommendations and fostered long-term collaborative
          initiatives across the combustion chemistry community.
        </p>
        <p>
          <a href="/archive">View all past editions →</a>
        </p>
      </div>

      <!-- Right: sidebar -->
      <aside>
        <div class="sidebar-block">
          <h4>Stay connected</h4>
          <a href="https://www.linkedin.com/company/ifcws/" target="_blank" rel="noopener" class="linkedin-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-label="LinkedIn">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <span>IFCWS on LinkedIn</span>
          </a>
          <a href="https://join.slack.com/t/international-ve11898/shared_invite/zt-42bcwnfph-9j6Y4v64WX7a3HgePPVI4Q" target="_blank" rel="noopener" class="slack-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 122.8 122.8" aria-label="Slack">
              <path d="M25.8 77.6c0 7.1-5.8 12.9-12.9 12.9S0 84.7 0 77.6s5.8-12.9 12.9-12.9h12.9v12.9zm6.5 0c0-7.1 5.8-12.9 12.9-12.9s12.9 5.8 12.9 12.9v32.3c0 7.1-5.8 12.9-12.9 12.9s-12.9-5.8-12.9-12.9V77.6z" fill="#e01e5a"/>
              <path d="M45.2 25.8c-7.1 0-12.9-5.8-12.9-12.9S38.1 0 45.2 0s12.9 5.8 12.9 12.9v12.9H45.2zm0 6.5c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9H12.9C5.8 58.1 0 52.3 0 45.2s5.8-12.9 12.9-12.9h32.3z" fill="#36c5f0"/>
              <path d="M97 45.2c0-7.1 5.8-12.9 12.9-12.9s12.9 5.8 12.9 12.9-5.8 12.9-12.9 12.9H97V45.2zm-6.5 0c0 7.1-5.8 12.9-12.9 12.9s-12.9-5.8-12.9-12.9V12.9C64.7 5.8 70.5 0 77.6 0s12.9 5.8 12.9 12.9v32.3z" fill="#2eb67d"/>
              <path d="M77.6 97c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9-12.9-5.8-12.9-12.9V97h12.9zm0-6.5c-7.1 0-12.9-5.8-12.9-12.9s5.8-12.9 12.9-12.9h32.3c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9H77.6z" fill="#ecb22e"/>
            </svg>
            <span>Join the Slack community</span>
          </a>
          <a href="mailto:matteo.pelucchi@polimi.it?subject=Subscribe%20to%20FCWS%20mailing%20list&body=Please%20add%20me%20to%20the%20FCWS%20mailing%20list." class="subscribe-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span>Subscribe to mailing list</span>
          </a>
        </div>

        <div class="sidebar-block">
          <h4>Important Dates</h4>
          <ul>
            <li>Poster abstract deadline<br/><strong>12 June 2026</strong></li>
            <li>Early bird registration until<br/><strong>21 June 2026</strong></li>
            <li>Regular registration until<br/><strong>12 July 2026</strong></li>
            <li>Workshop<br/><strong>25–26 July 2026</strong></li>
            <li><Ordinal n={41} /> ISOC<br/><strong>26–31 July 2026</strong></li>
          </ul>
        </div>

        <div class="sidebar-block">
          <h4>Joint Session</h4>
          <ul>
            <li>Half-morning session co-organized with the <strong>RCM Workshop</strong>, led by Scott Goldsborough, Argonne National Laboratory, USA, on common challenges and best practices for community-driven efforts.</li>
          </ul>
        </div>


        <div class="sidebar-block">
          <h4>Organised under</h4>
          <a href="https://www.combustioninstitute.org" target="_blank" rel="noopener" style="border:none; display:inline-block; margin-top:0.4rem;">
            <img
              src="/images/ci-logo.png"
              alt="The Combustion Institute"
              width="110"
            />
          </a>
        </div>
      </aside>

    </div>
  </div>
</Base>

<style>
.linkedin-link,
.subscribe-link,
.slack-link,
.github-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.5rem;
  text-decoration: none;
  font-size: 0.8rem;
  border: none;
}
.linkedin-link {
  color: var(--ink);
}
.linkedin-link svg {
  color: #0a66c2;
  flex-shrink: 0;
}
.subscribe-link {
  color: var(--ink);
}
.slack-link {
  color: var(--ink);
}
.slack-link svg {
  flex-shrink: 0;
}
.github-link {
  color: var(--ink);
}
.github-link svg {
  flex-shrink: 0;
}
.paper-card {
  border-left: 3px solid var(--blue);
  background: var(--bg-tinted);
  padding: 1rem 1.25rem;
  margin-bottom: 1.5rem;
  display: flex;
  gap: 1.25rem;
  align-items: flex-start;
}

.paper-cover {
  width: 64px;
  flex-shrink: 0;
  border: 1px solid var(--rule);
}

.paper-info { flex: 1; }

.paper-title {
  font-style: italic;
  font-size: 0.9rem;
  color: var(--ink);
  margin-bottom: 0.35rem;
  line-height: 1.45;
}

.paper-authors {
  font-size: 0.8rem;
  color: var(--ink-muted);
  margin-bottom: 0.25rem;
}

.paper-ref {
  font-size: 0.8rem;
  color: var(--ink-muted);
  margin-bottom: 0.4rem;
}

.paper-doi {
  font-size: 0.78rem;
  color: var(--blue);
  border-bottom-color: transparent;
}
.paper-doi:hover { border-bottom-color: var(--blue); }

.boa-card {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  border: none;
  border-left: 4px solid var(--blue);
  background: linear-gradient(135deg, var(--bg-tinted) 0%, var(--bg-warm) 100%);
  padding: 1.25rem 1.5rem;
  margin-bottom: 1.5rem;
  box-shadow: 0 1px 3px rgba(13, 27, 42, 0.06);
}

.boa-doc {
  flex-shrink: 0;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--blue);
  color: #fff;
}
.boa-doc svg { width: 24px; height: 24px; }

.boa-info {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  flex: 1;
  min-width: 0;
}

.boa-eyebrow {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--blue-mid);
}

.boa-title {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  color: var(--ink);
  line-height: 1.3;
}

.boa-desc {
  font-size: 0.85rem;
  color: var(--ink-muted);
}

.boa-actions {
  flex-shrink: 0;
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.boa-cta {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 0.4rem;
  background: var(--blue);
  color: #fff;
  font-size: 0.85rem;
  font-weight: 600;
  padding: 0.55rem 1rem;
  border-radius: 3px;
  white-space: nowrap;
}
a.boa-cta:hover { background: var(--blue-mid); }

@media (max-width: 560px) {
  .boa-card { flex-wrap: wrap; }
  .boa-actions { width: 100%; }
  .boa-cta { width: 100%; justify-content: center; }
}

.last-edition-photo-link {
  display: block;
  border: none;
  margin-top: 0.75rem;
}
.last-edition-photo {
  width: 100%;
  border-radius: 4px;
}
.last-edition-caption {
  display: block;
  margin-top: 0.4rem;
  font-size: 0.8rem;
  color: var(--ink-muted);
}
.last-edition-photo-link:hover .last-edition-caption {
  color: var(--blue);
}

.founders {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-top: 0.5rem;
}

.founder {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.founder img {
  width: 44px;
  height: 44px;
  object-fit: cover;
  object-position: center 20%;
  border-radius: 50%;
  flex-shrink: 0;
  filter: grayscale(20%);
  border: 2px solid var(--rule);
}

.founder div {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}

.founder strong {
  font-size: 0.875rem;
  color: var(--ink);
}

.founder span {
  font-size: 0.75rem;
  color: var(--ink-muted);
}
</style>
